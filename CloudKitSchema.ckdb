DEFINE SCHEMA

    RECORD TYPE CD_BudgetTemplate (
        "___createTime" TIMESTAMP SORTABLE,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP SORTABLE,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        CD_entityName   STRING,
        CD_uuid         STRING,
        CD_name         STRING,
        CD_iconName     STRING,
        CD_createdAt    TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_TemplateCategory (
        "___createTime" TIMESTAMP SORTABLE,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP SORTABLE,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        CD_entityName   STRING,
        CD_uuid         STRING,
        CD_name         STRING,
        CD_amount       STRING,
        CD_sortOrder    INT64,
        CD_iconName     STRING,
        CD_template     STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_DayOverride (
        "___createTime" TIMESTAMP SORTABLE,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP SORTABLE,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        CD_entityName   STRING,
        CD_dayKey       TIMESTAMP,
        CD_template     STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_SpendEntry (
        "___createTime" TIMESTAMP SORTABLE,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP SORTABLE,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        CD_entityName   STRING,
        CD_timestamp    TIMESTAMP,
        CD_dayKey       TIMESTAMP,
        CD_categoryName STRING,
        CD_categoryID   STRING,
        CD_amount       STRING,
        CD_scopeRaw     STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_PlanSettings (
        "___createTime"          TIMESTAMP SORTABLE,
        "___createdBy"           REFERENCE,
        "___etag"                STRING,
        "___modTime"             TIMESTAMP SORTABLE,
        "___modifiedBy"          REFERENCE,
        "___recordID"            REFERENCE QUERYABLE,
        CD_entityName            STRING,
        CD_weekdayTemplateUUIDs  BYTES,
        CD_weeklyOverallBudget   STRING,
        CD_monthlyOverallBudget  STRING,
        CD_carryoverRaw          STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
