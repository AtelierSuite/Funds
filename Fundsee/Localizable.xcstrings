    "Intent.DeletePlan.Confirm" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete %@? Days using it will have no budget until you assign another plan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@を削除しますか？このプランを使う日は、別のプランを割り当てるまで予算がなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@을(를) 삭제할까요? 이 플랜을 사용하는 날은 다른 플랜을 지정할 때까지 예산이 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要删除%@吗？使用它的日子在指定其他方案前将没有预算。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要刪除%@嗎？使用它的日子在指定其他方案前將沒有預算。"
          }
        }
      }
    },
