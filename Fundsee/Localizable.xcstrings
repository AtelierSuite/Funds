    "Intent.LogPayment.Description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logs a card payment, such as one passed in by a Wallet automation. Without a category, it uses the one you last chose for that merchant."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウォレットのオートメーションから渡されたものなど、カード決済を記録します。カテゴリを指定しない場合は、その店舗で前回選んだカテゴリを使います。"
          }
