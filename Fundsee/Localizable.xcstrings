    "Intent.TotalSpent.Description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds up spending between two dates, optionally for one category. Without dates, it covers this month so far."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2つの日付の間の支出を合計します。カテゴリで絞り込むこともできます。日付を指定しない場合は今月の支出が対象です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 날짜 사이의 지출을 합산하며, 카테고리 하나로 좁힐 수도 있습니다. 날짜를 지정하지 않으면 이번 달 지금까지의 지출이 대상입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "汇总两个日期之间的支出，也可只统计一个类别。未指定日期时，统计本月至今的支出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "彙總兩個日期之間的支出，也可只統計一個類別。未指定日期時，統計本月至今的支出。"
          }
        }
      }
    },
