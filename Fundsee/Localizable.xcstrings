    "Onboarding.Templates.Subtitle" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A plan is a day's budget, split into categories. We've made three to start. Tap one to adjust the amounts."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プランは1日の予算をカテゴリごとに分けたものです。まず3つご用意しました。タップして金額を調整できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플랜은 하루 예산을 카테고리별로 나눈 것입니다. 기본으로 세 가지를 준비했습니다. 탭하여 금액을 조정하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "方案是按类别划分的一天预算。已为你准备三个方案，点按即可调整金额。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "方案是按類別劃分的一天預算。已為你準備三個方案，點一下即可調整金額。"
          }
        }
      }
    },
