    "Intent.AddCategory.Description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds a category with a daily budget to a plan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1日の予算付きでカテゴリをプランに追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루 예산과 함께 카테고리를 플랜에 추가합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向方案添加带每日预算的类别。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向方案新增附每日預算的類別。"
          }
        }
      }
    },
    "Intent.AddCategory.Dialog" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
