{
  "sourceLanguage" : "en",
  "strings" : {
    "Carryover.Footer" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies globally to how unused or exceeded budget is treated."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未使用または超過した予算の扱いに、アプリ全体で適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "남거나 초과한 예산의 처리 방식에 전체적으로 적용됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全局适用于未用完或超支预算的处理方式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全域適用於未用完或超支預算的處理方式。"
          }
        }
      }
    },
    "Carryover.LeaveAsIs.Subtitle" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each day's budget stands on its own."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各日の予算はその日だけで完結します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루 예산은 그날에만 적용됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天的预算各自独立。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天的預算各自獨立。"
          }
        }
      }
    },
    "Carryover.LeaveAsIs.Title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave As-Is"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのままにする"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그대로 두기"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持不变"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "維持不變"
          }
        }
      }
    },
    "Carryover.NextDay.Subtitle" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unused budget increases tomorrow; overspend reduces it. Resets each week."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使わなかった予算は翌日に加算され、超過分は差し引かれます。毎週リセットされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "남은 예산은 다음 날에 더해지고 초과분은 차감됩니다. 매주 초기화됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未用完的预算会增加次日额度，超支则减少。每周重置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未用完的預算會增加隔天額度，超支則減少。每週重置。"
          }
        }
      }
    },
    "Carryover.NextDay.Title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carry to Next Day"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "翌日に繰り越す"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음 날로 이월"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "结转到次日"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "結轉至隔天"
          }
        }
      }
    },
    "Carryover.NextWeek.Subtitle" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Last week's leftover or overspend adjusts this week's budget."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先週の残額または超過分が今週の予算に反映されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지난주의 잔액이나 초과분이 이번 주 예산에 반영됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上周的结余或超支会调整本周预算。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上週的結餘或超支會調整本週預算。"
          }
        }
      }
    },
    "Carryover.NextWeek.Title" : {
      "localizations" : {
        "en" : {
