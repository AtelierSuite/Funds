    "OverallBudgets.Monthly.Footer" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extra budget added once per month, e.g. a 30-pack box of bread. Set to 0 to disable."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月に一度だけ加算される予算です。例: パンの30個入りまとめ買い。0にすると無効になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 달에 한 번 추가되는 예산입니다. 예: 30개들이 빵 한 박스. 0으로 설정하면 사용하지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每月加一次的额外预算，例如 30 个装的面包。设为 0 即停用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每月加一次的額外預算，例如 30 個裝的麵包。設為 0 即停用。"
          }
        }
      }
    },
