    "ManageData.DeleteAll.Alert.Message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your budget plans, week plan, and spending will be permanently deleted. This can't be undone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "予算プラン・一週間の予定・支出が完全に削除されます。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "예산 플랜, 주간 계획, 지출이 영구적으로 삭제됩니다. 이 작업은 실행 취소할 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的预算方案、每周计划和支出将被永久删除。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的預算方案、每週計畫和支出將被永久刪除。此操作無法復原。"
          }
        }
      }
    },
    "ManageData.DeleteAll.Alert.Message.ICloud" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your budget plans, week plan, and spending will be permanently deleted from this device and iCloud. This can't be undone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "予算プラン・一週間の予定・支出が、このデバイスとiCloudから完全に削除されます。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "예산 플랜, 주간 계획, 지출이 이 기기와 iCloud에서 영구적으로 삭제됩니다. 이 작업은 실행 취소할 수 없습니다."
          }
