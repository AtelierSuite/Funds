    "ManageData.DeleteAll.Alert.Message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your budget plans, week plan, and spending will be permanently deleted. This can't be undone."
          }
