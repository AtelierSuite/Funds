            "state" : "translated",
            "value" : "Your budgets stay private, synced securely with iCloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "予算はプライベートに保たれ、iCloudで安全に同期されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "예산은 비공개로 유지되며 iCloud를 통해 안전하게 동기화됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的预算保持私密，并通过 iCloud 安全同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的預算保持私密，並透過 iCloud 安全同步。"
          }
        }
      }
    },
