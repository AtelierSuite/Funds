    "Intent.LogSpend.Dialog.Left" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logged %1$@ for %2$@. %3$@ left today."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@に%1$@を記録しました。今日の残りは%3$@です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@에 %1$@ 기록했습니다. 오늘 %3$@ 남았습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已为%2$@记录%1$@。今天还剩%3$@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已為%2$@記錄%1$@。今天還剩%3$@。"
          }
        }
      }
    },
    "Intent.LogSpend.Dialog.Over" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logged %1$@ for %2$@. You're %3$@ over today."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@に%1$@を記録しました。今日は%3$@の超過です。"
          }
        },
        "ko" : {
