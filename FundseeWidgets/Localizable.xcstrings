    "Widget.Description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How much of today's budget is left."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の予算の残りを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 예산이 얼마나 남았는지 보여 줍니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示今日预算的剩余额度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示今日預算的剩餘額度。"
          }
        }
      }
    },
